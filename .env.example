# Database (Neon)
# Use the Neon pooler for runtime/serverless.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct (non-pooled) connection for migrations/introspection.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require&connect_timeout=15"

# Supabase Storage (event posters)
# Bucket should be PUBLIC if the frontend fetches directly.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET_EVENTS="event-posters"

# Stripe platform (server-side secret key)
STRIPE_SECRET_KEY="sk_live_or_test_..."

# Stripe Connect onboarding return base URL
STRIPE_CONNECT_RETURN_URL="https://backend-nighthub-788g.vercel.app/stripe/connect"

# Stripe Checkout return URL
STRIPE_CHECKOUT_RETURN_URL="https://backend-nighthub-788g.vercel.app/checkout/result"

# Public app/web base URL fallback
FRONTEND_APP_URL="https://backend-nighthub-788g.vercel.app"
