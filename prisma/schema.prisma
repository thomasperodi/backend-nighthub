}

// ===============================
// VENUE TABLES (STRUTTURALI)
// ===============================
model venue_tables {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id            String   @db.Uuid
  venue_table_zone_id String?  @db.Uuid
  nome                String
  zona                String?
  numero              Int?
  per_testa           Decimal? @db.Decimal(10, 2)
  costo_minimo        Decimal? @db.Decimal(10, 2)
  persone_max         Int?
  floor_x             Decimal? @db.Decimal(10, 2)
  floor_y             Decimal? @db.Decimal(10, 2)
  floor_w             Decimal? @db.Decimal(10, 2)
  floor_h             Decimal? @db.Decimal(10, 2)
