// ===============================
// PRISMA SETUP
// ===============================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===============================
// ENUM
// ===============================
enum UserRole {
  client
  staff
  venue
  admin
}

enum VenuePrRole {
  responsabile
  capo_squadra
  pr
}

enum EventStatus {
  DRAFT
  LIVE
  CLOSED
}

enum EventAccessMode {
  LIST
  PRE_SALE
}

enum TicketOrderStatus {
  created
  paid
  cancelled
  failed
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  completed
}

enum ReservationType {
  table
  entry
}

enum PromoStatus {
  active
  inactive
  expired
}

enum DiscountType {
  percentage
  fixed
  free
}

enum EntryMethod {
  QR
  RAPIDO
}

enum Gender {
  M
  F
  ALTRO
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
}

enum GroupTableProposalStatus {
  voting
  ready
  booked
  cancelled
}

enum GroupTableProposalVote {
  yes
  no
  pending
}

enum VenueStationType {
  entry
  cloakroom
  bar
  table
}

enum PresenceEventType {
  enter_venue
  exit_venue
  checkin
  sale
  reservation_created
  reservation_checked_in
}

enum PresenceEventSource {
  qr_checkin
  manual_checkin
  geofence
  bar_sale
  cloakroom_sale
  table_sale
  reservation
}

enum ForecastType {
  attendance
  list_conversion
  revenue_total
  revenue_entry
  revenue_bar
  revenue_cloakroom
  revenue_table
}

// ===============================
// USERS
// ===============================
model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  username      String?  @unique
  password_hash String
  role          UserRole

  name          String?
  phone         String?
  avatar        String?
  push_token    String?
  push_token_updated_at DateTime?
  location_sharing_enabled Boolean @default(false)
  last_latitude Decimal? @db.Decimal(9,6)
  last_longitude Decimal? @db.Decimal(9,6)
  last_location_accuracy_meters Int?
  last_location_updated_at DateTime?
  last_active_at DateTime?

  sesso         Gender?
  birth_date    DateTime?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  venue_id      String?  @db.Uuid
  venue         venues?  @relation(fields: [venue_id], references: [id])

  // 🔥 QUESTI DUE DEVONO ESISTERE ENTRAMBI
  entries        entries[] @relation("UserEntries")
  staff_entries  entries[] @relation("StaffEntries")
  pr_memberships venue_pr_memberships[] @relation("VenuePrMembershipUser")
  created_pr_memberships venue_pr_memberships[] @relation("VenuePrMembershipCreator")

  reservations  reservations[]
  ticket_orders ticket_orders[]
  user_promos   user_promos[]
  venue_stays   venue_stays[]

  sent_friend_requests     friend_requests[] @relation("FriendRequestsSent")
  received_friend_requests friend_requests[] @relation("FriendRequestsReceived")
  friendships              friendships[]     @relation("UserFriendships")
  friend_groups            friend_groups[]
  group_memberships        friend_group_members[]
  created_group_table_proposals group_table_proposals[] @relation("GroupTableProposalCreator")
  group_table_proposal_votes    group_table_proposal_votes[]

  @@index([venue_id])
  @@index([username])
  @@index([location_sharing_enabled, last_location_updated_at])
  @@index([last_active_at])
}



// ===============================
// VENUES (LOCALI)
// ===============================
model venues {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  city        String?
  address     String?
  description String?
  image       String?
  latitude    Decimal? @db.Decimal(9,6)
  longitude   Decimal? @db.Decimal(9,6)
  radius_geofence Int    @default(100)
  stripe_account_id String? @unique
  cloakroom_unit_price Decimal @default(3) @db.Decimal(10,2)
  bar_price_list Json?
  stripe_charges_enabled Boolean @default(false)
  stripe_payouts_enabled Boolean @default(false)
  stripe_onboarding_completed_at DateTime?
  contract_start_at DateTime?
  contract_end_at DateTime?
  contract_status String?
  contract_monthly_fee Decimal? @db.Decimal(10,2)
  contract_auto_renew Boolean @default(false)
  contract_notes String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  events      events[]
  tables      venue_tables[]
  promos      promos[]
  users       users[]
  pr_memberships venue_pr_memberships[]
  pr_event_assignments venue_pr_event_assignments[]
  pr_qr_scans venue_pr_qr_scans[]
  venue_stays venue_stays[]
  stations    venue_stations[]
  group_table_proposals group_table_proposals[]
}

model venue_pr_memberships {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id             String   @db.Uuid
  user_id              String   @db.Uuid
  role                 VenuePrRole
  parent_membership_id String?  @db.Uuid
  ref_code             String
  is_active            Boolean  @default(true)
  created_by_user_id   String?  @db.Uuid
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  venue               venues                @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  user                users                 @relation("VenuePrMembershipUser", fields: [user_id], references: [id], onDelete: Cascade)
  parent_membership   venue_pr_memberships? @relation("VenuePrMembershipHierarchy", fields: [parent_membership_id], references: [id], onDelete: SetNull)
  child_memberships   venue_pr_memberships[] @relation("VenuePrMembershipHierarchy")
  created_by_user     users?                @relation("VenuePrMembershipCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  event_assignments   venue_pr_event_assignments[]
  qr_scans            venue_pr_qr_scans[]
  tracked_entries     entries[]             @relation("PrMembershipEntries")

  @@unique([venue_id, user_id])
  @@unique([venue_id, ref_code])
  @@index([venue_id, role, is_active])
  @@index([parent_membership_id])
}

model venue_pr_event_assignments {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id            String   @db.Uuid
  event_id            String   @db.Uuid
  pr_membership_id    String   @db.Uuid
  is_active           Boolean  @default(true)
  assigned_by_user_id String?  @db.Uuid
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  venue         venues               @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  event         events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  pr_membership venue_pr_memberships @relation(fields: [pr_membership_id], references: [id], onDelete: Cascade)

  @@unique([event_id, pr_membership_id])
  @@index([venue_id, event_id, is_active])
  @@index([pr_membership_id, is_active])
}

model venue_pr_qr_scans {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id           String   @db.Uuid
  event_id           String   @db.Uuid
  pr_membership_id   String   @db.Uuid
  scanned_by_user_id String?  @db.Uuid
  guest_user_id      String?  @db.Uuid
  referral_code      String
  scanned_at         DateTime @default(now())
  entry_id           String?  @db.Uuid
  entered_at         DateTime?
  metadata           Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  venue         venues               @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  event         events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  pr_membership venue_pr_memberships @relation(fields: [pr_membership_id], references: [id], onDelete: Cascade)

  @@index([venue_id, event_id, scanned_at])
  @@index([pr_membership_id, scanned_at])
  @@index([entry_id])
  @@index([guest_user_id, scanned_at])
}

model venue_stations {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id     String           @db.Uuid
  name         String
  station_type VenueStationType
  is_active    Boolean          @default(true)
  sort_order   Int              @default(0)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  venue        venues           @relation(fields: [venue_id], references: [id])

  @@unique([venue_id, name])
  @@index([venue_id, station_type, is_active])
  @@index([venue_id, sort_order])
}

// ===============================
// FRIEND REQUESTS
// ===============================
model friend_requests {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_user_id String               @db.Uuid
  to_user_id   String               @db.Uuid
  status       FriendRequestStatus  @default(pending)
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt

  from_user    users @relation("FriendRequestsSent", fields: [from_user_id], references: [id])
  to_user      users @relation("FriendRequestsReceived", fields: [to_user_id], references: [id])

  @@unique([from_user_id, to_user_id])
  @@index([to_user_id, status])
  @@index([from_user_id, status])
}

// ===============================
// FRIENDSHIPS (BI-DIRECTIONAL)
// ===============================
model friendships {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  friend_id  String   @db.Uuid
  created_at DateTime @default(now())

  user       users @relation("UserFriendships", fields: [user_id], references: [id])

  @@unique([user_id, friend_id])
  @@index([friend_id])
}

// ===============================
// FRIEND GROUPS
// ===============================
model friend_groups {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id   String   @db.Uuid
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner      users @relation(fields: [owner_id], references: [id])
  members    friend_group_members[]
  table_proposals group_table_proposals[]

  @@index([owner_id])
}

model friend_group_members {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())

  group      friend_groups @relation(fields: [group_id], references: [id])
  user       users         @relation(fields: [user_id], references: [id])

  @@unique([group_id, user_id])
  @@index([user_id])
}

model group_table_proposals {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id             String                   @db.Uuid
  created_by_user_id   String                   @db.Uuid
  event_id             String                   @db.Uuid
  venue_id             String                   @db.Uuid
  guests               Int
  note                 String?
  status               GroupTableProposalStatus @default(voting)
  booked_reservation_id String?                 @unique @db.Uuid
  created_at           DateTime                 @default(now())
  updated_at           DateTime                 @updatedAt

  group                friend_groups            @relation(fields: [group_id], references: [id])
  created_by_user      users                    @relation("GroupTableProposalCreator", fields: [created_by_user_id], references: [id])
  event                events                   @relation(fields: [event_id], references: [id])
  venue                venues                   @relation(fields: [venue_id], references: [id])
  booked_reservation   reservations?            @relation("BookedProposalReservation", fields: [booked_reservation_id], references: [id])
  votes                group_table_proposal_votes[]

  @@index([group_id, created_at])
  @@index([created_by_user_id, created_at])
  @@index([event_id])
  @@index([venue_id])
}

model group_table_proposal_votes {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposal_id String                 @db.Uuid
  user_id     String                 @db.Uuid
  vote        GroupTableProposalVote @default(pending)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt

  proposal    group_table_proposals  @relation(fields: [proposal_id], references: [id])
  user        users                  @relation(fields: [user_id], references: [id])

  @@unique([proposal_id, user_id])
  @@index([user_id, updated_at])
}

// ===============================
// VENUE STAYS (PERMANENZA CLIENTI)
// ===============================
model venue_stays {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  venue_id    String   @db.Uuid
  event_id    String?  @db.Uuid
  entered_at  DateTime
  exited_at   DateTime?
  duration_ms Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        users    @relation(fields: [user_id], references: [id])
  venue       venues   @relation(fields: [venue_id], references: [id])

  @@index([user_id, entered_at])
  @@index([venue_id, entered_at])
  @@index([venue_id, exited_at])
  @@index([event_id, entered_at])
}

// ===============================
// EVENTS
// ===============================
model events {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id    String      @db.Uuid
  name        String
  description String?
  image       String?
  is_featured Boolean     @default(false)
  date        DateTime    @db.Date
  start_time  DateTime?   @db.Time(6)
  end_time    DateTime?   @db.Time(6)
  status      EventStatus @default(DRAFT)
  access_mode EventAccessMode @default(LIST)
  presale_price Decimal?
  presale_currency String @default("eur")
  presale_capacity Int?
  presale_sold Int @default(0)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  venue       venues      @relation(fields: [venue_id], references: [id])

  entries     entries[]
  entry_prices event_entry_prices[]
  event_tables event_tables[]
  reservations reservations[]
  ticket_orders ticket_orders[]
  promos      promos[]
  bar_sales   bar_sales[]
  cloakroom_sales cloakroom_sales[]
  pr_event_assignments venue_pr_event_assignments[]
  pr_qr_scans venue_pr_qr_scans[]
  group_table_proposals group_table_proposals[]

  @@index([venue_id, date])
  @@index([date, start_time])
  @@index([status])
  @@index([is_featured, date])
}

// ===============================
// EVENT ENTRY PRICES (LISTINO INGRESSI)
// - Optional gender (null = all)
// - Optional time window (nulls = always)
// ===============================
model event_entry_prices {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid

  label      String?
  gender     Gender?
  start_time DateTime? @db.Time(6)
  end_time   DateTime? @db.Time(6)
  price      Decimal

  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id])
}

// ===============================
// VENUE TABLES (STRUTTURALI)
// ===============================
model venue_tables {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id     String   @db.Uuid
  nome         String
  zona         String?
  numero       Int?
  per_testa    Decimal?
  costo_minimo Decimal?
  persone_max  Int?

  venue        venues    @relation(fields: [venue_id], references: [id])
  event_tables event_tables[]
  reservations reservations[]

  @@unique([venue_id, numero])
}

// ===============================
// EVENT TABLES (STATO TAVOLO PER EVENTO)
// ===============================
model event_tables {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id       String   @db.Uuid
  venue_table_id String   @db.Uuid
  assigned_number Int?
  per_testa_override    Decimal?
  costo_minimo_override Decimal?
  persone_max_override  Int?

  prenotati     Int      @default(0)
  entrati       Int      @default(0)
  pagato_totale Decimal  @default(0)
  stato         String   @default("libero")
  confermato    Boolean  @default(false)

  event         events       @relation(fields: [event_id], references: [id])
  venue_table   venue_tables @relation(fields: [venue_table_id], references: [id])
  table_sales   table_sales[]

  @@unique([event_id, venue_table_id])
  @@index([event_id])
  @@index([event_id, confermato])
  @@index([event_id, assigned_number])
}

// ===============================
// ENTRIES (INGRESSI)
// ===============================
model entries {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  event_id   String      @db.Uuid
  user_id    String?     @db.Uuid
  staff_id   String?     @db.Uuid
  station_id String?     @db.Uuid
  pr_membership_id String? @db.Uuid

  sesso      Gender
  price      Decimal     @default(0)
  method     EntryMethod

  created_at DateTime    @default(now())

  event      events      @relation(fields: [event_id], references: [id])

  user       users?      @relation("UserEntries", fields: [user_id], references: [id])
  staff      users?      @relation("StaffEntries", fields: [staff_id], references: [id])
  pr_membership venue_pr_memberships? @relation("PrMembershipEntries", fields: [pr_membership_id], references: [id], onDelete: SetNull)

  @@index([event_id, created_at])
  @@index([event_id, station_id, created_at])
  @@index([user_id])
  @@index([staff_id])
  @@index([station_id])
  @@index([pr_membership_id, created_at])
}




// ===============================
// BAR SALES
// ===============================
model bar_sales {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  station_id String?  @db.Uuid
  staff_id   String?  @db.Uuid
  amount     Decimal
  metadata   Json?
  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id, created_at])
  @@index([event_id, station_id, created_at])
  @@index([staff_id, created_at])
}

// ===============================
// CLOAKROOM SALES
// ===============================
model cloakroom_sales {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  station_id String?  @db.Uuid
  staff_id   String?  @db.Uuid
  amount     Decimal
  metadata   Json?
  created_at DateTime @default(now())

  event events @relation(fields: [event_id], references: [id])

  @@index([event_id, created_at])
  @@index([event_id, station_id, created_at])
  @@index([staff_id, created_at])
}

// ===============================
// TABLE SALES
// ===============================
model table_sales {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String?  @db.Uuid
  event_table_id String   @db.Uuid
  station_id      String?  @db.Uuid
  staff_id        String?  @db.Uuid
  amount         Decimal
  metadata       Json?
  created_at     DateTime @default(now())

  event_table event_tables @relation(fields: [event_table_id], references: [id])

  @@index([event_id, created_at])
  @@index([event_table_id, created_at])
  @@index([event_id, station_id, created_at])
  @@index([staff_id, created_at])
}

model event_presence_events {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id       String              @db.Uuid
  venue_id       String              @db.Uuid
  user_id        String?             @db.Uuid
  reservation_id String?             @db.Uuid
  entry_id       String?             @db.Uuid
  station_id     String?             @db.Uuid
  event_type     PresenceEventType
  source         PresenceEventSource
  amount         Decimal?            @db.Decimal(10,2)
  occurred_at    DateTime
  metadata       Json?
  created_at     DateTime            @default(now())

  @@index([event_id, occurred_at])
  @@index([venue_id, occurred_at])
  @@index([station_id, occurred_at])
  @@index([user_id, occurred_at])
}

model event_analytics_snapshots {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id               String   @db.Uuid
  venue_id               String   @db.Uuid
  snapshot_date          DateTime @db.Date
  entries_count          Int      @default(0)
  unique_attendees       Int      @default(0)
  reservations_count     Int      @default(0)
  ticket_orders_count    Int      @default(0)
  avg_stay_minutes       Decimal? @db.Decimal(10,2)
  male_count             Int      @default(0)
  female_count           Int      @default(0)
  other_gender_count     Int      @default(0)
  unknown_gender_count   Int      @default(0)
  age_18_20              Int      @default(0)
  age_21_24              Int      @default(0)
  age_25_29              Int      @default(0)
  age_30_34              Int      @default(0)
  age_35_plus            Int      @default(0)
  entry_revenue          Decimal  @default(0) @db.Decimal(12,2)
  bar_revenue            Decimal  @default(0) @db.Decimal(12,2)
  cloakroom_revenue      Decimal  @default(0) @db.Decimal(12,2)
  table_revenue          Decimal  @default(0) @db.Decimal(12,2)
  total_revenue          Decimal  @default(0) @db.Decimal(12,2)
  generated_at           DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@unique([event_id, snapshot_date])
  @@index([venue_id, snapshot_date])
}

model event_forecasts {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id         String       @db.Uuid
  venue_id         String       @db.Uuid
  forecast_type    ForecastType
  model_version    String
  predicted_value  Decimal      @db.Decimal(12,2)
  lower_bound      Decimal?     @db.Decimal(12,2)
  upper_bound      Decimal?     @db.Decimal(12,2)
  confidence_score Decimal?     @db.Decimal(5,2)
  features_snapshot Json?
  generated_at     DateTime     @default(now())

  @@index([event_id, forecast_type, generated_at])
  @@index([venue_id, forecast_type, generated_at])
}

model user_copresence_edges {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id                String?  @db.Uuid
  user_a_id               String   @db.Uuid
  user_b_id               String   @db.Uuid
  first_seen_at           DateTime?
  last_seen_at            DateTime?
  same_event_count        Int      @default(0)
  same_arrival_count      Int      @default(0)
  same_table_count        Int      @default(0)
  avg_arrival_gap_seconds Int?
  strength_score          Decimal? @db.Decimal(8,2)
  updated_at              DateTime @updatedAt

  @@unique([user_a_id, user_b_id, venue_id])
  @@index([venue_id, strength_score])
  @@index([user_a_id, strength_score])
  @@index([user_b_id, strength_score])
}

// ===============================
// PROMOS
// ===============================
model promos {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id       String        @db.Uuid
  event_id       String?       @db.Uuid
  title          String
  description    String?
  discount_type  DiscountType
  discount_value Decimal?
  status         PromoStatus   @default(active)
  created_at     DateTime      @default(now())

  venue          venues        @relation(fields: [venue_id], references: [id])
  event          events?       @relation(fields: [event_id], references: [id])
  user_promos    user_promos[]

  @@index([event_id, status, created_at])
  @@index([venue_id, created_at])
}

// ===============================
// USER PROMOS
// ===============================
model user_promos {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String   @db.Uuid
  promo_id  String   @db.Uuid
  used_at   DateTime?

  user  users  @relation(fields: [user_id], references: [id])
  promo promos @relation(fields: [promo_id], references: [id])

  @@unique([user_id, promo_id])
}

// ===============================
// RESERVATIONS
// ===============================
model reservations {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String            @db.Uuid
  event_id     String            @db.Uuid
  venue_table_id String?         @db.Uuid
  table_name   String?
  meta         Json?
  type         ReservationType
  status       ReservationStatus @default(pending)
  guests       Int
  total_amount Decimal?
  qr_token     String?           @unique
  qr_payload   String?
  checked_in_at DateTime?
  checked_in_by_staff_id String? @db.Uuid
  checkin_entry_id String?       @db.Uuid
  created_at   DateTime          @default(now())

  user  users  @relation(fields: [user_id], references: [id])
  event events @relation(fields: [event_id], references: [id])
  venue_table venue_tables? @relation(fields: [venue_table_id], references: [id])
  ticket_order ticket_orders?
  booked_from_group_proposal group_table_proposals? @relation("BookedProposalReservation")

  @@index([event_id])
  @@index([user_id])
  @@index([venue_table_id])
  @@index([event_id, created_at])
  @@index([user_id, created_at])
  @@index([event_id, type, status])
  @@index([checked_in_by_staff_id])
}

model ticket_orders {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String            @db.Uuid
  event_id             String            @db.Uuid
  stripe_account_id    String
  reservation_id       String?           @unique @db.Uuid
  status               TicketOrderStatus @default(created)
  quantity             Int               @default(1)
  amount_total         Decimal
  currency             String            @default("eur")
  stripe_session_id    String            @unique
  stripe_payment_intent String?
  checkout_url         String?
  paid_at              DateTime?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  user                 users             @relation(fields: [user_id], references: [id])
  event                events            @relation(fields: [event_id], references: [id])
  reservation          reservations?     @relation(fields: [reservation_id], references: [id])

  @@index([user_id, created_at])
  @@index([event_id, created_at])
  @@index([status, created_at])
  @@index([stripe_account_id, created_at])
}
