  list_conversion
  revenue_total
  revenue_entry
  revenue_bar
  revenue_cloakroom
  revenue_table
}

// ===============================
// USERS
// ===============================
model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  username      String?  @unique
  password_hash String
  role          UserRole

  name                          String?
  phone                         String?
  avatar                        String?
  is_active                     Boolean   @default(true)
  push_token                    String?
  push_token_updated_at         DateTime?
  onboarding_completed_at       DateTime?
  location_sharing_enabled      Boolean   @default(false)
  last_latitude                 Decimal?  @db.Decimal(9, 6)
  last_longitude                Decimal?  @db.Decimal(9, 6)
  last_location_accuracy_meters Int?
  last_location_updated_at      DateTime?
  last_active_at                DateTime?

  sesso      Gender?
  birth_date DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  venue_id String? @db.Uuid
  venue    venues? @relation(fields: [venue_id], references: [id])

  // Mirrors venue_id/venue above, for `role: organization` accounts (an organization's own
  // business account, as opposed to a `client` who happens to hold a venue_pr_memberships
  // row - see venue_pr_memberships.organization_id for that side of the relationship).
  organization_id String?        @db.Uuid
  organization    organizations? @relation(fields: [organization_id], references: [id])

  // 🔥 QUESTI DUE DEVONO ESISTERE ENTRAMBI
  entries                  entries[]                        @relation("UserEntries")
  staff_entries            entries[]                        @relation("StaffEntries")
  pr_memberships           venue_pr_memberships[]           @relation("VenuePrMembershipUser")
  created_pr_memberships   venue_pr_memberships[]           @relation("VenuePrMembershipCreator")
  pr_membership_passes     venue_pr_membership_passes[]     @relation("VenuePrMembershipPassUser")
  pr_membership_pass_scans venue_pr_membership_pass_scans[] @relation("VenuePrMembershipPassScanStaff")

  reservations            reservations[]
  ticket_orders           ticket_orders[]
  user_promos             user_promos[]
  venue_stays             venue_stays[]
  requested_bottle_orders table_bottle_orders[] @relation("BottleOrderRequestedBy")
  prepared_bottle_orders  table_bottle_orders[] @relation("BottleOrderPreparedBy")
  delivered_bottle_orders table_bottle_orders[] @relation("BottleOrderDeliveredBy")

  sent_friend_requests          friend_requests[]            @relation("FriendRequestsSent")
  received_friend_requests      friend_requests[]            @relation("FriendRequestsReceived")
  friendships                   friendships[]                @relation("UserFriendships")
  friend_groups                 friend_groups[]
  group_memberships             friend_group_members[]
  created_group_table_proposals group_table_proposals[]      @relation("GroupTableProposalCreator")
  group_table_proposal_votes    group_table_proposal_votes[]
  user_badges                   user_badges[]
  refresh_tokens                refresh_tokens[]
  push_subscriptions            push_subscriptions[]
  filed_content_reports         content_reports[]            @relation("ContentReportReporter")
  content_reports_received      content_reports[]            @relation("ContentReportReported")

  organization_venue_links_created organization_venue_links[] @relation("OrganizationVenueLinkCreator")

  @@index([venue_id])
  @@index([organization_id])
  @@index([username])
  @@index([location_sharing_enabled, last_location_updated_at])
  @@index([last_active_at])
}

// Refresh-token session store backing the access/refresh auth flow (AuthService).
// One row per issued refresh token; `family_id` links every token produced by rotating
// the same original login (a "session"), which is what lets reuse-detection revoke the
// whole chain at once instead of a single token. Only a SHA-256 hash of the opaque token
// is ever stored - the raw value only ever exists in the HttpOnly cookie and in-flight.
model refresh_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  user        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash  String    @unique
  family_id   String    @db.Uuid
  replaced_by String?   @unique @db.Uuid
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime  @default(now())
  user_agent  String?
  ip          String?

  @@index([user_id, revoked_at])
  @@index([family_id])
}

// Web Push subscriptions (browser/PWA), one row per device/browser - unlike `users.push_token`
// (a single Expo/mobile token per user), a user can have many of these at once. Each is keyed
// by its unique push service `endpoint`; deleted on logout (client-initiated) or automatically
// when the push service reports it as gone (410/404 on send).
model push_subscriptions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  user         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint     String   @unique
  p256dh       String
  auth_key     String
  user_agent   String?
  created_at   DateTime @default(now())
  last_seen_at DateTime @default(now())

  @@index([user_id])
}

// Marks a legacy (non-Supabase) password-reset JWT as consumed. The reset token itself
// stays a short-lived stateless JWT (see AuthService.requestPasswordReset); this table only
// records that a given token's `jti` has already been redeemed, so a second attempt with
// the same link/token inside its validity window is rejected instead of silently working.
model used_password_reset_tokens {
  jti        String   @id
  used_at    DateTime @default(now())
  expires_at DateTime
}

// ===============================
// ORGANIZATIONS
// ===============================
// An organization is an independent business entity that works events at one or more
// venues, bringing its own PR team - it is NOT a subdivision of a venue. Venue↔organization
// links are created by platform admins only (organization_venue_links), and a PR's
// venue_pr_memberships row is tagged with the organization it works for (nullable, since
// pre-existing PRs predate this and a PR can currently work for at most one organization -
// see venue_pr_memberships.organization_id).
model organizations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  vat_number String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Organizations are the paying/monetized entity going forward, not venues (confirmed
  // business decision) - one flat plan per organization, independent of how many venues it
  // works. Reuses the same subscription_plans catalog venues already use (no separate
  // org-specific catalog was requested). See venues.plan_id's doc comment for the other,
  // now-legacy side of this.
  plan_id String?             @db.Uuid
  plan    subscription_plans? @relation("OrganizationPlan", fields: [plan_id], references: [id], onDelete: SetNull)

  owners         users[]
  venue_links    organization_venue_links[]
  pr_memberships venue_pr_memberships[]

  @@index([plan_id])
}

// Which venues an organization is allowed to work events at. Deliberately admin-only to
// create/remove (not a bilateral request/accept flow like a friend request, and not
// self-service by either side) - see created_by_admin_id.
model organization_venue_links {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String   @db.Uuid
  venue_id            String   @db.Uuid
  created_by_admin_id String?  @db.Uuid
  created_at          DateTime @default(now())

  organization     organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  venue            venues        @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  created_by_admin users?        @relation("OrganizationVenueLinkCreator", fields: [created_by_admin_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, venue_id])
  @@index([venue_id])
}

// ===============================
// VENUES (LOCALI)
// ===============================
model venues {
  id                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                           String
  city                           String?
  address                        String?
  description                    String?
  image                          String?
  latitude                       Decimal?  @db.Decimal(9, 6)
  longitude                      Decimal?  @db.Decimal(9, 6)
  radius_geofence                Int       @default(100)
  stripe_account_id              String?   @unique
  cloakroom_unit_price           Decimal   @default(3) @db.Decimal(10, 2)
  bar_price_list                 Json?
  bottle_price_list              Json?
  stripe_charges_enabled         Boolean   @default(false)
  stripe_payouts_enabled         Boolean   @default(false)
  stripe_onboarding_completed_at DateTime?
  contract_start_at              DateTime?
  contract_end_at                DateTime?
  contract_status                String?
  contract_monthly_fee           Decimal?  @db.Decimal(10, 2)
  contract_auto_renew            Boolean   @default(false)
  contract_notes                 String?
  // Legacy: billing is moving to organizations.plan_id (confirmed business decision - see
  // that field's doc comment). Kept as-is (not migrated/removed) so venues with a plan
  // already assigned today don't lose that data or break the existing admin UI; new billing
  // relationships should be created on organizations, not here.
  plan_id                        String?   @db.Uuid
  plan_custom_terms              Json?
  created_at                     DateTime  @default(now())
  updated_at                     DateTime  @updatedAt

  events                   events[]
  tables                   venue_tables[]
  promos                   promos[]
  users                    users[]
  pr_memberships           venue_pr_memberships[]
  pr_event_assignments     venue_pr_event_assignments[]
  pr_qr_scans              venue_pr_qr_scans[]
  pr_membership_passes     venue_pr_membership_passes[]
  pr_membership_pass_scans venue_pr_membership_pass_scans[]
  venue_stays              venue_stays[]
  stations                 venue_stations[]
  table_zones              venue_table_zones[]
  floor_plan               venue_floor_plans?
  group_table_proposals    group_table_proposals[]
  plan                     subscription_plans?              @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  organization_links       organization_venue_links[]

  @@index([plan_id])
}

// NightHub listino: catalog of subscription plans sold to venues (Essential/Pulse/Peak/Elite).
// `monthly_price`/`included_events`/`included_people` null = custom, negotiated per venue
// (Elite) - `is_custom` flags that case for the UI instead of inferring it from nulls.
model subscription_plans {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String   @unique
  name               String
  tagline            String?
  icon               String?
  monthly_price      Decimal? @db.Decimal(10, 2)
  included_events    Int?
  included_people    Int?
  extra_event_price  Decimal? @db.Decimal(10, 2)
  extra_person_price Decimal? @db.Decimal(10, 4)
  is_custom          Boolean  @default(false)
  is_recommended     Boolean  @default(false)
  is_active          Boolean  @default(true)
  sort_order         Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  venues        venues[]
  organizations organizations[] @relation("OrganizationPlan")
}

model venue_pr_memberships {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id             String      @db.Uuid
  user_id              String      @db.Uuid
  role                 VenuePrRole
  parent_membership_id String?     @db.Uuid
  ref_code             String
  is_active            Boolean     @default(true)
  created_by_user_id   String?     @db.Uuid
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  // Which organization this PR currently works for at this venue - nullable because
  // existing memberships predate organizations and need a backfill decision (see the
  // Organizations audit doc), and because a PR is not required to belong to one. A PR works
  // for at most one organization at a time (confirmed business rule): this is a plain FK,
  // not a join table. Scoped through the venue like the rest of this model - if the
  // organization stops working this venue, this membership's organization_id should be
  // cleared/deactivated along with it, not kept dangling.
  organization_id String?        @db.Uuid
  organization    organizations? @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  venue             venues                           @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  user              users                            @relation("VenuePrMembershipUser", fields: [user_id], references: [id], onDelete: Cascade)
  parent_membership venue_pr_memberships?            @relation("VenuePrMembershipHierarchy", fields: [parent_membership_id], references: [id], onDelete: SetNull)
  child_memberships venue_pr_memberships[]           @relation("VenuePrMembershipHierarchy")
  created_by_user   users?                           @relation("VenuePrMembershipCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  event_assignments venue_pr_event_assignments[]
  qr_scans          venue_pr_qr_scans[]
  tracked_entries   entries[]                        @relation("PrMembershipEntries")
  season_pass       venue_pr_membership_passes?
  season_pass_scans venue_pr_membership_pass_scans[]

  @@unique([venue_id, user_id])
  @@unique([venue_id, ref_code])
  @@index([venue_id, role, is_active])
  @@index([parent_membership_id])
  @@index([organization_id, is_active])
}

model venue_pr_event_assignments {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id            String   @db.Uuid
  event_id            String   @db.Uuid
  pr_membership_id    String   @db.Uuid
  is_active           Boolean  @default(true)
  assigned_by_user_id String?  @db.Uuid
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  venue         venues               @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  event         events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  pr_membership venue_pr_memberships @relation(fields: [pr_membership_id], references: [id], onDelete: Cascade)

  @@unique([event_id, pr_membership_id])
  @@index([venue_id, event_id, is_active])
  @@index([pr_membership_id, is_active])
}

model venue_pr_qr_scans {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id           String    @db.Uuid
  event_id           String    @db.Uuid
  pr_membership_id   String    @db.Uuid
  scanned_by_user_id String?   @db.Uuid
  guest_user_id      String?   @db.Uuid
  referral_code      String
  scanned_at         DateTime  @default(now())
  entry_id           String?   @db.Uuid
  entered_at         DateTime?
  metadata           Json?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  venue         venues               @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  event         events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  pr_membership venue_pr_memberships @relation(fields: [pr_membership_id], references: [id], onDelete: Cascade)

  // Anti-spam: the same PR can't register more than one scan for the same guest at the
  // same event - without this, a compromised/careless actor could inflate a PR's scan
  // stats by replaying the same guest repeatedly. Partial (guest_user_id can be null for
  // scans not tied to a specific guest, which aren't subject to this dedup).
  @@unique([event_id, pr_membership_id, guest_user_id], map: "uniq_pr_qr_scan_per_guest")
  @@index([venue_id, event_id, scanned_at])
  @@index([pr_membership_id, scanned_at])
  @@index([entry_id])
  @@index([guest_user_id, scanned_at])
}

model venue_pr_membership_passes {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id              String                      @db.Uuid
  pr_membership_id      String                      @unique @db.Uuid
  user_id               String                      @db.Uuid
  status                VenuePrMembershipPassStatus @default(active)
  valid_from            DateTime                    @default(now())
  valid_until           DateTime
  qr_token              String                      @unique
  serial_number         String                      @unique
  wallet_apple_url      String?
  wallet_google_url     String?
  wallet_last_issued_at DateTime?
  revoked_at            DateTime?
  metadata              Json?
  created_at            DateTime                    @default(now())
  updated_at            DateTime                    @updatedAt

  venue         venues                           @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  pr_membership venue_pr_memberships             @relation(fields: [pr_membership_id], references: [id], onDelete: Cascade)
  user          users                            @relation("VenuePrMembershipPassUser", fields: [user_id], references: [id], onDelete: Cascade)
  scans         venue_pr_membership_pass_scans[]

  @@index([venue_id, status])
  @@index([user_id, status])
  @@index([valid_until])
}

model venue_pr_membership_pass_scans {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pass_id            String   @db.Uuid
  venue_id           String   @db.Uuid
  event_id           String?  @db.Uuid
  pr_membership_id   String   @db.Uuid
  scanned_by_user_id String?  @db.Uuid
  entry_id           String?  @db.Uuid
  scan_result        String   @default("accepted")
  reason             String?
  qr_payload         String?
  scanned_at         DateTime @default(now())
  created_at         DateTime @default(now())

  pass            venue_pr_membership_passes @relation(fields: [pass_id], references: [id], onDelete: Cascade)
  venue           venues                     @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  event           events?                    @relation(fields: [event_id], references: [id], onDelete: SetNull)
  pr_membership   venue_pr_memberships       @relation(fields: [pr_membership_id], references: [id], onDelete: Cascade)
  scanned_by_user users?                     @relation("VenuePrMembershipPassScanStaff", fields: [scanned_by_user_id], references: [id], onDelete: SetNull)

  @@index([pass_id, scanned_at])
  @@index([venue_id, event_id, scanned_at])
  @@index([pr_membership_id, scanned_at])
  @@index([scan_result, scanned_at])
}

model venue_stations {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id     String           @db.Uuid
  name         String
  station_type VenueStationType
  is_active    Boolean          @default(true)
  sort_order   Int              @default(0)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  venue venues @relation(fields: [venue_id], references: [id])

  @@unique([venue_id, name])
  @@index([venue_id, station_type, is_active])
  @@index([venue_id, sort_order])
}

model venue_table_zones {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id       String                  @db.Uuid
  name           String
  color          String?
  per_testa      Decimal?                @db.Decimal(10, 2)
  costo_minimo   Decimal?                @db.Decimal(10, 2)
  persone_max    Int?
  booking_policy VenueTableBookingPolicy @default(exclusive)
  sort_order     Int                     @default(0)
  floor_x        Decimal?                @db.Decimal(10, 2)
  floor_y        Decimal?                @db.Decimal(10, 2)
  floor_w        Decimal?                @db.Decimal(10, 2)
  floor_h        Decimal?                @db.Decimal(10, 2)
  is_active      Boolean                 @default(true)
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt

  venue        venues         @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  tables       venue_tables[]
  reservations reservations[]
  event_tables event_tables[]

  @@unique([venue_id, name])
  @@index([venue_id, sort_order])
  @@index([venue_id, is_active])
}

model venue_floor_plans {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id         String   @unique @db.Uuid
  background_image String?
  canvas_width     Decimal  @default(1000) @db.Decimal(10, 2)
  canvas_height    Decimal  @default(700) @db.Decimal(10, 2)
  grid_size        Decimal  @default(24) @db.Decimal(10, 2)
  show_grid        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  venue     venues                  @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  landmarks venue_floor_landmarks[]

  @@index([venue_id])
}

model venue_floor_landmarks {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  floor_plan_id String                 @db.Uuid
  type          VenueFloorLandmarkType @default(dj_console)
  label         String?
  x             Decimal                @default(0) @db.Decimal(10, 2)
  y             Decimal                @default(0) @db.Decimal(10, 2)
  width         Decimal                @default(120) @db.Decimal(10, 2)
  height        Decimal                @default(48) @db.Decimal(10, 2)
  rotation      Decimal                @default(0) @db.Decimal(10, 2)
  color         String?
  metadata      Json?
  sort_order    Int                    @default(0)
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt

  floor_plan venue_floor_plans @relation(fields: [floor_plan_id], references: [id], onDelete: Cascade)

  @@index([floor_plan_id, sort_order])
  @@index([floor_plan_id, type])
}

// ===============================
// FRIEND REQUESTS
// ===============================
model friend_requests {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  from_user_id String              @db.Uuid
  to_user_id   String              @db.Uuid
  status       FriendRequestStatus @default(pending)
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  from_user users @relation("FriendRequestsSent", fields: [from_user_id], references: [id])
  to_user   users @relation("FriendRequestsReceived", fields: [to_user_id], references: [id])

  @@unique([from_user_id, to_user_id])
  @@index([to_user_id, status])
  @@index([from_user_id, status])
}

// ===============================
// FRIENDSHIPS (BI-DIRECTIONAL)
// ===============================
model friendships {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
