// ===============================
// EVENTS
// ===============================
model events {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id         String               @db.Uuid
  name             String
  description      String?
  image            String?
  // Single "in evidence" flag with two possible sources, tracked by `featured_source`:
  // an admin can grant it manually (paid placement - a venue can never set this on itself,
  // see EventsController), or the periodic hype-evaluation cron can grant it automatically
  // (free reward for booking velocity above this venue's own historical average). The cron
  // only ever touches events it granted itself (`featured_source = auto`) - it never
  // switches off something an admin turned on manually, and never turns on something an
  // admin explicitly turned off (see EventsService.evaluateAutoFeaturedEvents).
  is_featured      Boolean              @default(false)
  featured_source  EventFeaturedSource?
  date             DateTime             @db.Date
  start_time       DateTime?            @db.Time(6)
  end_time         DateTime?            @db.Time(6)
  status           EventStatus          @default(DRAFT)
  access_mode      EventAccessMode      @default(LIST)
  presale_price    Decimal?
  presale_currency String               @default("eur")
  presale_capacity Int?
  presale_sold     Int                  @default(0)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  venue venues @relation(fields: [venue_id], references: [id])

  entries                  entries[]
  entry_prices             event_entry_prices[]
  event_tables             event_tables[]
  reservations             reservations[]
  ticket_orders            ticket_orders[]
  promos                   promos[]
  bar_sales                bar_sales[]
  cloakroom_sales          cloakroom_sales[]
  pr_event_assignments     venue_pr_event_assignments[]
  pr_qr_scans              venue_pr_qr_scans[]
  pr_membership_pass_scans venue_pr_membership_pass_scans[]
  group_table_proposals    group_table_proposals[]

  @@index([venue_id, date])
  @@index([date, start_time])
  @@index([status])
  @@index([is_featured, date])
}

// ===============================
// EVENT ENTRY PRICES (LISTINO INGRESSI)
// - Optional gender (null = all)
// - Optional time window (nulls = always)
// ===============================
model event_entry_prices {
