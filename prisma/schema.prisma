  client
  staff
  venue
  admin
  organization
}

enum VenuePrRole {
  responsabile
  capo_squadra
  pr
}

enum VenuePrMembershipPassStatus {
  active
  revoked
  expired
}

enum EventStatus {
  DRAFT
  LIVE
  CLOSED
  CANCELLED
}

// Who last turned events.is_featured on - see the field's doc comment on `model events`.
enum EventFeaturedSource {
  manual
  auto
}

enum EventAccessMode {
  LIST
  PRE_SALE
}

enum TicketOrderStatus {
  created
  paid
  cancelled
  failed
}

enum TableBottleOrderStatus {
  requested
  preparing
  delivered
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  completed
}

enum ReservationType {
  table
  entry
}

enum PromoStatus {
  active
  inactive
  expired
}

enum DiscountType {
  percentage
  fixed
  free
}

enum EntryMethod {
  QR
  RAPIDO
}

enum Gender {
  M
  F
  ALTRO
}

enum AgeBucket {
  AGE_18_20
  AGE_21_24
  AGE_25_29
  AGE_30_34
  AGE_35_PLUS
  UNKNOWN
}

enum BadgeCategory {
  NIGHTLIFE
  EXPLORATION
  SOCIAL
  SQUAD
  TABLES_VIP
  STREAK
  NIGHT_CHALLENGES
  SPECIAL_EVENTS
  MILESTONE
