{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/events/sync-status",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/auth/cleanup-tokens",
      "schedule": "0 4 * * *"
    }
  ]
}
